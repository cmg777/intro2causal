# Virtual environment
.venv/

# Python
__pycache__/
*.pyc

# Quarto rendered output (regenerated from .qmd)
notebooks_quarto/*.html

# Quarto book project (keep _book/ tracked for GitHub Pages)
book/.quarto/
book/**/*.quarto_ipynb

# Large data files (download from masteringmetrics.com/resources/)
*.dta
data/ch1/*.xlsx

# Copyrighted source material: local reference only, never commit or push
/latex-original-book/
/original-book/

# OS files
.DS_Store

# IDE
.idea/
.vscode/

# Claude plans (ephemeral)
.claude/plans/
.claude/tasks/
.claude/image-cache/

# Slide decks: keep source + rendered output; ignore staging + Quarto caches
slides/*/_figcache/
slides/*/.quarto/

# /draw-mindmap batch ZIP exports (images already live in mindmaps/images/)
mindmaps/*.zip

# Completed podcast audio is published; other recordings and local caches stay private
mindmaps-podcast/audio/*
!mindmaps-podcast/audio/ch01-randomized-trials.mp3
!mindmaps-podcast/audio/ch02-regression.mp3
!mindmaps-podcast/audio/ch03-instrumental-variables.mp3
!mindmaps-podcast/audio/ch04-regression-discontinuity.mp3
!mindmaps-podcast/audio/ch05-differences-in-differences.mp3
!mindmaps-podcast/audio/ch06-wages-of-schooling.mp3
.work/podcast/
