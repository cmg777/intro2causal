---
title: "{{TITLE}}"
subtitle: "{{SUBTITLE}}"
deck-author: "{{AUTHOR}}"           # title-slide author name (hyperlinked below)
deck-author-url: "{{AUTHOR_URL}}"   # the author's homepage, e.g. https://carlos-mendez.org
institute: "{{INSTITUTE}}"          # the university line, e.g. Nagoya University (GSID)
date: today                         # auto-stamps the render/update date ("created or updated")
date-format: long                   # renders e.g. "October 13, 2026"
visual-summary: "{{VISUAL_SUMMARY}}"  # the title slide's key visual — path to the chapter's
                                      # visual summary, e.g. figures/visual_summary.svg. The
                                      # closing Recap slide reuses the SAME path, so swapping in
                                      # the mind-map image later is a two-line change.
format:
  revealjs:
    output-file: index.html
    # NOT embed-resources: RevealChalkboard (a core feature) is incompatible with
    # self-contained output, so the deck ships index.html + slides_files/. Images are
    # referenced locally as figures/<name> (staged by scripts/export_chapter_figures.py).
    # The deck is a pure Pandoc render (no kernel); mermaid diagrams render client-side.
    theme: [default, site-brand.scss]
    template-partials:
      - title-slide.html
    # Click-to-zoom lightbox for figures: click any figure → full-screen overlay with
    # zoom controls (+/−/reset/fullscreen), scroll-to-zoom, drag-to-pan, Esc to close.
    # Self-contained (no CDN); copied verbatim into the deck bundle.
    include-after-body: figure-zoom.html
    center: true              # vertical-centres content → centred dividers + strategic white space
    slide-number: c/t
    menu: true                # revealjs-menu plugin (press M)
    chalkboard: true          # draw on slides (press B)
    preview-links: auto
    overview: true            # press O
    progress: true
    history: true
    transition: fade
    width: 1280
    height: 720
    fig-align: center         # + auto-stretch (default on) bounds images to the slide → no overflow
    auto-stretch: true
    highlight-style: github-dark
    mermaid-format: svg       # pre-render diagrams at build time (headless Chrome). Live (js)
                              # mermaid measures labels inside reveal's CSS-scaled slide and
                              # truncates them; figure-zoom.html then fits each SVG's height to
                              # its viewBox, and site-brand.scss fixes label whitespace.
    mermaid:
      theme: dark             # light edges/labels on the DeepSlate canvas; node fills come from
                              # each diagram's own `style X fill:#…,color:#fff` lines
    # Math: MathJax (Quarto revealjs DEFAULT) — renders $…$ / $$…$$ across the whole slide
    # DOM (body, captions, headings, table cells). Loads from a CDN; reveal.js is local.
    # Do NOT set `html-math-method: katex` — it is broken in revealjs (no auto-render call,
    # so math shows as raw LaTeX). See references/render-and-fix.md.
    link-external-icon: false
---

