    "model = pf.feols(\"mrate ~ legal + C(state) + C(year)\", data=allcause, weights=allcause[\"pop\"])\n",
    "result = model.fit(cov_type=\"cluster\", cov_kwds={\"groups\": allcause[\"state\"]})\n",
    "print(f\"\\nWeighted DD estimate: {round(result.coef()['legal'], 2)}\")\n",
    "\n",
    "# --- Step 5: Placebo test (suicide should NOT respond to drinking age) ---\n",
